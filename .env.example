SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Company Email (Used to send emails)
SMTP_USERNAME=your_company_email@gmail.com
SMTP_PASSWORD=your_app_password_here

# Sender Information
FROM_EMAIL=your_company_email@gmail.com
FROM_NAME=Advanced Approval Management System (AAMS)

# Super Admin (CEO)
SUPER_ADMIN_EMAIL=your_ceo_email@gmail.com

# Default Admin Notification Email
ADMIN_NOTIFY_EMAIL=your_admin_notify_email@gmail.com

# Optional
COMPANY_NAME=Advanced Approval Management System
COMPANY_SHORT_NAME=AAMS

# Super Admin Password
SUPER_ADMIN_PASSWORD=your_super_admin_password_here

# ------------------------------------------------------------------
# Optional settings. Uncomment and fill in the ones you need.
# ------------------------------------------------------------------

# Signs login sessions. Required in production; generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# JWT_SECRET_KEY=

# How long a login session lasts, in hours (default 8)
# JWT_ACCESS_TOKEN_HOURS=8

# Super Admin created on first start (overrides the defaults in main.py)
# INITIAL_SUPER_ADMIN_EMAIL=
# INITIAL_SUPER_ADMIN_PASSWORD=

# PostgreSQL connection string. Leave unset to use the local SQLite file auth.db
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Public URL used in account setup and password reset emails
# APP_BASE_URL=https://your-app.onrender.com

# Comma-separated browser origins allowed to call the API (default http://localhost:5000)
# CORS_ORIGINS=https://your-app.onrender.com

# Send email through SendGrid's HTTP API instead of SMTP
# SENDGRID_API_KEY=

# Set to "production" to force secure cookies outside Render
# ENVIRONMENT=production
